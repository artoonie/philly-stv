{
  "name": "philly-stv-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulates how Philadelphia City Council would look under proportional representation (STV).",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "serve": "python3 -m http.server 8080 --directory site",
    "screenshot": "node scripts/screenshot.js",
    "review": "node scripts/screenshot.js && node scripts/review.js",
    "test:browser": "node tests/drag.browser.js",
    "social": "node scripts/social.js"
  }
}
